      "parameters": {
        "jsCode": "// Ambil output teks dari node LLM Chain\nconst llmOutput = $json.text;\n\n// Ambil message ID langsung dari Gmail Trigger\n// (LLM Chain hanya meneruskan $json.text, bukan $json.id)\nconst emailMessageId = $('Gmail Trigger').item.json.id;\n\n// Gunakan regex untuk menemukan pola \"Skor: [angka]\"\nconst match = llmOutput.match(/Skor:\\s*(\\d+)/);\n\nlet score = 0;\n\n// Jika pola ditemukan, ekstrak angkanya\nif (match && match[1]) {\n  score = parseInt(match[1], 10);\n}\n\n// Kembalikan skor dan messageId dalam format array item n8n\nreturn [\n  {\n    json: {\n      score: score,\n      messageId: emailMessageId\n    }\n  }\n];"
