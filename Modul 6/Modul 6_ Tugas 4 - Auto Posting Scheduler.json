    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Set zona waktu Jakarta\nconst now = DateTime.now().setZone('Asia/Jakarta');\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  // Gunakan nama kolom persis seperti di Google Sheet\n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n\n  // Pastikan kolom terisi dan status Pending\n  if (row.Status === 'Pending' && dateStr && timeStr) {\n    \n    let scheduledTime;\n    \n    // Google Sheets mengembalikan tanggal dalam format DD/MM/YYYY\n    // Gunakan DateTime.fromFormat() untuk parse format ini\n    if (dateStr.includes('/')) {\n      // Format: DD/MM/YYYY HH:mm:ss\n      scheduledTime = DateTime.fromFormat(\n        `${dateStr} ${timeStr}`,\n        'dd/MM/yyyy HH:mm:ss',\n        { zone: 'Asia/Jakarta' }\n      );\n    } else {\n      // Format: YYYY-MM-DD (ISO fallback)\n      const dateTimeString = `${dateStr}T${timeStr}`;\n      scheduledTime = DateTime.fromISO(dateTimeString, { zone: 'Asia/Jakarta' });\n    }\n\n    // Cek validitas waktu & apakah sudah waktunya post\n    if (scheduledTime.isValid && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;\n"
      },
